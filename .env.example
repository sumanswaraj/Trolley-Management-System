# Choose your own password, minimum 12 characters. Never commit .env.
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=8080
SECURE_COOKIE=false

# Optional, required for reader provisioning: 32 random bytes as 64 hex characters.
# Back up this key separately from the database. Do not commit it.
DEVICE_ENCRYPTION_KEY=

# Only for compose.production.yaml; use your confirmed DNS hostname.
TROLLEY_DOMAIN=
